# Cloudflare R2 凭证 — 复制为 .env.local 后填写真实值
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nyancy-stickers
# 自定义 CDN 域名（不含协议、不含斜杠）
R2_PUBLIC_HOST=cdn.example.com

# 暴露给前端使用（必须 NEXT_PUBLIC_ 前缀），通常 = R2_PUBLIC_HOST
NEXT_PUBLIC_R2_HOST=cdn.example.com

# 批量上传请求体上限
NEXT_SERVER_ACTION_BODY_SIZE_LIMIT=100mb

# 可选：本地访问 Cloudflare R2 需要代理时填写
R2_PROXY_URL=
