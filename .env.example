# Cloudflare R2 凭证 — 复制为 .env.local 后填写真实值
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nyancy-stickers
# 自定义 CDN 域名（不含协议、不含斜杠）
R2_PUBLIC_HOST=s3.yokina.moe

# 暴露给前端使用（必须 NEXT_PUBLIC_ 前缀），通常 = R2_PUBLIC_HOST
NEXT_PUBLIC_R2_HOST=s3.yokina.moe

# 投稿/批量上传请求体上限
NEXT_SERVER_ACTION_BODY_SIZE_LIMIT=100mb

# 可选：本地访问 Cloudflare R2 需要代理时填写（仅 http(s):// 协议，不支持 socks5）
# Vercel 生产环境留空。
R2_PROXY_URL=

# Neon Postgres
# DATABASE_URL：pooled 连接（运行时用），DATABASE_URL_UNPOOLED：直连（drizzle-kit migrate 用）
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js v5
# AUTH_SECRET：openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App
# - callback URL（dev）：http://localhost:3000/api/auth/callback/github
# - callback URL（prod）：https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# 部署到生产时设置为完整公开 URL，dev 留空即可
NEXTAUTH_URL=

# 逗号分隔的 GitHub login 列表。这些用户登录时会被强制 promote 为 admin（超级管理员）；
# 列表里被移除的旧 admin 重新登录时会被强制降回 user。普通管理员 (editor) 在后台由超管手动提拔。
# 空列表 = 跳过强制对齐（首次部署或希望完全后台管理时使用）。
ADMIN_GITHUB_LOGINS=
